{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?i).*pt.*"
        }
      ],
      "destination": "/pt",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pt",
      "destination": "/rendercv_output/Felipe-Carvalho-CV-pt/Felipe_Carvalho_CV"
    },
    {
      "source": "/en",
      "destination": "/rendercv_output/Felipe-Carvalho-CV-en/Felipe_Carvalho_CV"
    }
  ]
}
